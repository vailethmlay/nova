# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgres://nova:change-me@localhost:5432/nova

# Public origin and WebAuthn relying-party ID (the bare hostname).
NOVA_ORIGIN=http://localhost:3000
NOVA_RP_ID=localhost

# One-time token required to register the first passkey. Generate with: openssl rand -hex 24
NOVA_SETUP_TOKEN=

# AI (server-side only). Leave empty to run with chat disabled.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Phase 2: GitHub App (read-only). See SETUP.md. ---
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# base64 of the .pem file: base64 -w0 nova.private-key.pem
GITHUB_APP_PRIVATE_KEY_BASE64=
GITHUB_WEBHOOK_SECRET=

# --- Phase 2: WhatsApp Cloud API (Meta). See SETUP.md. ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ALERT_TEMPLATE=nova_alert
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_API_VERSION=v25.0
