# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgres://nova:change-me@localhost:5432/nova

# Public origin and WebAuthn relying-party ID (the bare hostname).
NOVA_ORIGIN=http://localhost:3000
NOVA_RP_ID=localhost

# One-time token required to register the first passkey. Generate with: openssl rand -hex 24
NOVA_SETUP_TOKEN=

# AI (server-side only). Leave empty to run with chat disabled.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
